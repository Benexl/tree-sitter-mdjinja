{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mdjinja",
      "camelcase": "mdjinja",
      "title": "mdjinja",
      "scope": "source.mdjinja",
      "file-types": [
        "md.jinja",
        "md.jinja2",
        "md.j2"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^mdjinja$",
      "class-name": "TreeSitterMdJinja"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "MIT",
    "description": "A tree-sitter grammar for the md jinja",
    "authors": [
      {
        "name": "William Vandervalk",
        "url": "https://williamvandervalk.com/"
      }
    ],
    "links": {
      "repository": "https://github.com/Benexl/tree-sitter-mdjinja.git"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
